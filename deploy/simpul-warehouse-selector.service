[Unit]
Description=Warehouse selection service
Documentation=https://github.com/dipaadipati/simpul-warehouse-selector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=simpul
Group=simpul

WorkingDirectory=/opt/simpul-warehouse-selector

# Node 24 strips the TypeScript types at load time, so the source runs directly
# and there is no build step between git pull and restart.
#
# This path assumes Node was installed system-wide (NodeSource apt, or the
# official tarball). A version manager such as nvm puts the binary under /home,
# which ProtectHome=true below hides from the service - install Node system-wide
# for this unit, or use the container in docker-compose.yml instead.
ExecStart=/usr/bin/node src/http/server.ts

Environment=NODE_ENV=production
# Bind to loopback only. Nginx is the public face and the only thing that should
# be able to reach this port.
Environment=HOST=127.0.0.1
Environment=PORT=3000
# The delivery log lives outside the checkout: it is the company's data and is
# not in the repository. Comment this out to run without it, in which case the
# "minutes" objective reports itself unavailable and the core path is unaffected.
Environment=SIMPUL_HISTORY_PATH=/var/lib/simpul/customer1-historical.csv

Restart=always
RestartSec=3

# The process only reads the checkout and the log, and listens on a socket. It
# never writes to disk, so almost everything can be taken away from it.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# MemoryDenyWriteExecute is deliberately absent: V8 needs writable, executable
# memory for its JIT, and the setting stops Node from starting at all.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
